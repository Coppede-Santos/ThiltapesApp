<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard</title>
  <style>
    body { font-family: "Segoe UI", sans-serif; margin: 0; background: #f4f6f8; }
    .wrap { max-width: 1100px; margin: 28px auto; padding: 0 16px; }
    .card { background: #fff; padding: 24px; border-radius: 12px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); }
    h1 { margin: 0 0 8px; font-size: 22px; }
    h2 { margin: 0 0 12px; font-size: 18px; }
    .section { margin-top: 16px; }
    .stack { display: grid; gap: 16px; }
    .msg { padding: 10px 12px; border-radius: 8px; margin-bottom: 12px; }
    .erro { background: #ffe9ec; color: #b00020; }
    .ok { background: #e9f8ef; color: #136c33; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .grid3 { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 8px; align-items: center; }
    .field { margin-bottom: 12px; }
    .full { grid-column: 1 / -1; }
    label { display: block; font-size: 14px; margin-bottom: 6px; }
    input, select { width: 100%; padding: 10px; border: 1px solid #d0d7de; border-radius: 8px; box-sizing: border-box; }
    button { padding: 10px 14px; border: 0; border-radius: 8px; background: #0b6cff; color: #fff; font-weight: 600; cursor: pointer; }
    .danger { background: #d83b01; }
    .tableWrap { overflow: auto; border: 1px solid #e6e9ef; border-radius: 10px; }
    table { width: 100%; border-collapse: collapse; min-width: 760px; }
    th, td { border-bottom: 1px solid #e6e9ef; padding: 10px; text-align: left; vertical-align: middle; }
    th { font-size: 13px; color: #4c5665; background: #f9fafb; }
    tr:last-child td { border-bottom: 0; }
    .inline { display: flex; gap: 8px; align-items: center; }
    .inline input, .inline select { min-width: 100px; }
    .tiny { width: 110px; }
    .fotoLink { max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: inline-block; vertical-align: middle; }
    @media (max-width: 800px) {
      .grid { grid-template-columns: 1fr; }
      .grid3 { grid-template-columns: 1fr; }
      .tiny { width: 100%; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card stack">
      <div>
        <h1>Dashboard Admin</h1>
      </div>
      <% if (erro) { %>
        <div class="msg erro"><%= erro %></div>
      <% } %>
      <% if (sucesso) { %>
        <div class="msg ok"><%= sucesso %></div>
      <% } %>

      <div class="section">
        <h2>Usuarios</h2>
        <form method="post" action="/thiltapes-api/admin/player" class="grid3" style="margin-bottom: 12px;">
          <input name="nome" type="text" placeholder="Nome do usuario" required />
          <button type="submit" class="tiny">Adicionar</button>
          <span></span>
        </form>

        <div class="tableWrap">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Capturas</th>
                <th>Acoes</th>
              </tr>
            </thead>
            <tbody>
              <% if (!players || players.length === 0) { %>
                <tr><td colspan="4">Nenhum usuario cadastrado.</td></tr>
              <% } %>
              <% (players || []).forEach(function(p) { %>
                <tr>
                  <td><%= p.id %></td>
                  <td>
                    <form method="post" action="/thiltapes-api/admin/player/<%= p.id %>/update" class="inline">
                      <input name="nome" type="text" value="<%= p.nome %>" required />
                      <button type="submit" class="tiny">Salvar</button>
                    </form>
                  </td>
                  <td><%= p.capturas %></td>
                  <td>
                    <form method="post" action="/thiltapes-api/admin/player/<%= p.id %>/delete" onsubmit="return confirm('Excluir usuario #<%= p.id %>?');">
                      <button type="submit" class="danger tiny">Excluir</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="section">
        <h2>Cadastrar Thiltape</h2>
        <form method="post" action="/thiltapes-api/admin/thiltape" enctype="multipart/form-data">
          <div class="grid">
            <div class="field full">
              <label for="nome">Nome</label>
              <input id="nome" name="nome" type="text" required />
            </div>

            <div class="field">
              <label for="raridade">Raridade</label>
              <select id="raridade" name="raridade" required>
                <option value="Comum">Comum</option>
                <option value="Raro">Raro</option>
                <option value="Lendario">Lendario</option>
              </select>
            </div>

            <div class="field">
              <label for="foto">Foto</label>
              <input id="foto" name="foto" type="file" accept="image/*" />
            </div>

            <div class="field">
              <label for="lat">Latitude</label>
              <input id="lat" name="lat" type="number" step="any" required />
            </div>

            <div class="field">
              <label for="lng">Longitude</label>
              <input id="lng" name="lng" type="number" step="any" required />
            </div>

            <div class="field full">
              <button type="submit">Salvar</button>
            </div>
          </div>
        </form>
      </div>

      <div class="section">
        <h2>Thiltapes Cadastrados</h2>
        <div class="tableWrap">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Raridade</th>
                <th>Foto</th>
                <th>Lat</th>
                <th>Lng</th>
                <th>Acoes</th>
              </tr>
            </thead>
            <tbody>
              <% if (!thiltapes || thiltapes.length === 0) { %>
                <tr><td colspan="7">Nenhum thiltape cadastrado.</td></tr>
              <% } %>
              <% (thiltapes || []).forEach(function(t) { %>
                <tr>
                  <td><%= t.id %></td>
                  <td>
                    <form method="post" action="/thiltapes-api/admin/thiltape/<%= t.id %>/update" enctype="multipart/form-data" class="inline">
                      <input name="nome" type="text" value="<%= t.nome %>" required />
                  </td>
                  <td>
                      <select name="raridade" class="tiny" required>
                        <option value="Comum" <%= t.raridade === 'Comum' ? 'selected' : '' %>>Comum</option>
                        <option value="Raro" <%= t.raridade === 'Raro' ? 'selected' : '' %>>Raro</option>
                        <option value="Lendario" <%= t.raridade === 'Lendario' ? 'selected' : '' %>>Lendario</option>
                      </select>
                  </td>
                  <td>
                      <% if (t.foto) { %>
                        <a class="fotoLink" href="<%= t.foto %>" target="_blank"><%= t.foto %></a>
                      <% } else { %>
                        -
                      <% } %>
                      <input name="foto" type="file" accept="image/*" class="tiny" />
                  </td>
                  <td>
                      <input name="lat" type="number" step="any" value="<%= t.lat %>" class="tiny" required />
                  </td>
                  <td>
                      <input name="lng" type="number" step="any" value="<%= t.lng %>" class="tiny" required />
                  </td>
                  <td>
                      <button type="submit" class="tiny">Salvar</button>
                    </form>
                    <form method="post" action="/thiltapes-api/admin/thiltape/<%= t.id %>/delete" onsubmit="return confirm('Excluir thiltape #<%= t.id %>?');" style="margin-top:6px;">
                      <button type="submit" class="danger tiny">Excluir</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
